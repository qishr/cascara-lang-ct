    symbolIcon.stringForeground = symbol.string; //The foreground color for string symbols.
    symbolIcon.structForeground = symbol.struct; //The foreground color for struct symbols.
    symbolIcon.textForeground = symbol.text; //The foreground color for text symbols.
    symbolIcon.typeParameterForeground = symbol.typeParameter; //The foreground color for type parameter symbols.
    symbolIcon.unitForeground = symbol.unit; //The foreground color for unit symbols.
    symbolIcon.variableForeground = symbol.variable; //The foreground color for variable symbols.

    // The terminal background is given a color with zero opacity so that
    // the terminal's background color is not rendered. The avoids a color
    // mismatch between the terminal background an the panel background
    // for some colors which appears to be the result of a rounding error
    // in the terminal renering pipeline.
    terminal.background = #00000000;

    terminal.border = terminal.border; //The color of the border that separates split panes within the terminal. This defaults to panel.border.
    terminal.foreground = terminal.foreground; //The default foreground color of the Integrated Terminal.
    terminal.ansiBlack = terminal.black; //'Black' ANSI color in the terminal.
    terminal.ansiBlue = terminal.blue; //'Blue' ANSI color in the terminal.
    terminal.ansiBrightBlack = terminal.brightBlack; //'BrightBlack' ANSI color in the terminal.
    terminal.ansiBrightBlue = terminal.brightBlue; //'BrightBlue' ANSI color in the terminal.
    terminal.ansiBrightCyan = terminal.brightCyan; //'BrightCyan' ANSI color in the terminal.
    terminal.ansiBrightGreen = terminal.brightGreen; //'BrightGreen' ANSI color in the terminal.
    terminal.ansiBrightMagenta = terminal.brightMagenta; //'BrightMagenta' ANSI color in the terminal.
    terminal.ansiBrightRed = terminal.brightRed; //'BrightRed' ANSI color in the terminal.
    terminal.ansiBrightWhite = terminal.brightWhite; //'BrightWhite' ANSI color in the terminal.
    terminal.ansiBrightYellow = terminal.brightYellow; //'BrightYellow' ANSI color in the terminal.
    terminal.ansiCyan = terminal.cyan; //'Cyan' ANSI color in the terminal.
    terminal.ansiGreen = terminal.green; //'Green' ANSI color in the terminal.
    terminal.ansiMagenta = terminal.magenta; //'Magenta' ANSI color in the terminal.
    terminal.ansiRed = terminal.red; //'Red' ANSI color in the terminal.
    terminal.ansiWhite = terminal.white; //'White' ANSI color in the terminal.
    terminal.ansiYellow = terminal.yellow; //'Yellow' ANSI color in the terminal.

    terminal.selectionBackground = terminal.selectionBackground; //The selection background color of the terminal.
    terminal.selectionForeground = terminal.selectionForeground; //The selection foreground color of the terminal. When this is null the selection foreground will be retained and have the minimum contrast ratio feature applied.
    terminal.inactiveSelectionBackground = terminal.inactiveSelectionBackground; //The selection background color of the terminal when it does not have focus.
    terminal.findMatchBackground = terminal.findMatchBackground; //Color of the current search match in the terminal. The color must not be opaque so as not to hide underlying terminal content.
    terminal.findMatchBorder = terminal.findMatchBorder; //Border color of the current search match in the terminal.
    terminal.findMatchHighlightBackground = terminal.findMatchHighlightBackground; //Color of the other search matches in the terminal. The color must not be opaque so as not to hide underlying terminal content.
    terminal.findMatchHighlightBorder = terminal.findMatchHighlightBorder; //Border color of the other search matches in the terminal.
    terminal.hoverHighlightBackground = terminal.hoverHighlightBackground; //Color of the highlight when hovering a link in the terminal.
    terminalCursor.background = terminal.cursorBackground; //The background color of the terminal cursor. Allows customizing the color of a character overlapped by a block cursor.
    terminalCursor.foreground = terminal.cursorForeground; //The foreground color of the terminal cursor.
    terminal.dropBackground = terminal.dropBackground; //The background color when dragging on top of terminals. The color should have transparency so that the terminal contents can still shine through.
    terminal.tab.activeBorder = terminal.tabActiveBorder; //Border on the side of the terminal tab in the panel. This defaults to tab.activeBorder.

