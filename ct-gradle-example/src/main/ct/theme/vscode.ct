    //

    gitDecoration.untrackedResourceForeground = scm.resourceUntrackedForeground;
    gitDecoration.modifiedResourceForeground = scm.resourceModifiedForeground;
    gitDecoration.ignoredResourceForeground = scm.resourceIgnoredForeground;
    scmGraph.foreground1 = scm.graphForeground1;
    scmGraph.foreground2 = scm.graphForeground2;
    scmGraph.foreground3 = scm.graphForeground3;
    scmGraph.foreground4 = scm.graphForeground4;
    scmGraph.foreground5 = scm.graphForeground5;
    scmGraph.historyItemRefColor = scm.graphHistoryItemRefColor;
    scmGraph.historyItemRemoteRefColor = scm.graphHistoryItemRemoteRefColor;
    scmGraph.historyItemBaseRefColor = scm.graphHistoryItemBaseRefColor;


    //
    // Debug
    //

    debugIcon.startForeground = debug.startForeground;
    debugIcon.pauseForeground = debug.pauseForeground;
    debugIcon.stopForeground = debug.stopForeground;
    debugIcon.disconnectForeground = debug.disconnectForeground;
    debugIcon.restartForeground = debug.restartForeground;
    debugIcon.stepOverForeground = debug.stepOverForeground;
    debugIcon.stepIntoForeground = debug.stepIntoForeground;
    debugIcon.stepOutForeground = debug.stepOutForeground;
    debugIcon.continueForeground = debug.continueForeground;
    debugIcon.stepBackForeground = debug.stepBackForeground;
};

Palette vscode-syntax = {
    annotation = symbol.variable;
    character = symbol.string;
    comment = lang.comment;
    constant = symbol.constant;
    identifier = symbol.number;
    keyword = symbol.keyword;
    modifier = lang.modifier;
    method = symbol.method;
    namespace = symbol.namespace;
    number = symbol.number;
    operator = symbol.operator;
    other = symbol.text;
    primitive_type = symbol.class;
    reference_type = symbol.class;
    regex = lang.regex;
    string = symbol.string;
    variable = symbol.variable;
    yaml_name = symbol.key;
    yaml_value = symbol.string;
    yaml_punctuation = lang.punctuation;
};

