Format ghostty = {
    template = "ghostty-template";
    suffix = ".conf";
};

Template ghostty-template = {{{
shell-integration-features = no-cursor\n

{{{ insert ghostty-ui, ghostty-palette separator "\n" }}}

background-opacity = 0.95
background-blur = true
minimum-contrast = 1.05

cursor-style = block
cursor-style-blink = true

window-padding-x = 10
window-padding-y = 10
}}};

Template ghostty-ui = {{{
{{{ iterate ghostty-ui-element }}}
}}};

Template ghostty-ui-element = {{{
%name% = %value%
}}};

// Template ghostty-palette = {{{
// {{{ iterate ghostty-palette-element }}}
// }}};

// // Converts 'palette0 = #0e0a06' to 'palette = 0=#0e0a06'
// Template ghostty-palette-element = {{{
// palette = %name.replace("palette", "")% = %value%
// }}};

Template ghostty-palette = {{{

palette = 0={{{palette0}}}
palette = 1={{{palette1}}}
palette = 2={{{palette2}}}
palette = 3={{{palette3}}}
palette = 4={{{palette4}}}
palette = 5={{{palette5}}}
palette = 6={{{palette6}}}
palette = 7={{{palette7}}}
palette = 8={{{palette8}}}
palette = 9={{{palette9}}}
palette = 10={{{palette10}}}
palette = 11={{{palette11}}}
palette = 12={{{palette12}}}
palette = 13={{{palette13}}}
palette = 14={{{palette14}}}
palette = 15={{{palette15}}}
}}};

